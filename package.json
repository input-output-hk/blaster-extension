{
  "name": "blaster-extension",
  "publisher": "cardano-ha",
  "displayName": "Blaster",
  "description": "Discover and verify Lean properties with Blaster in Visual Studio Code.",
  "icon": "images/blaster-logo.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "workspaces": [
    "webview-ui"
  ],
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Blaster loads and checks executable Lean project code."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "walkthroughs": [
      {
        "id": "blaster-extension.welcome",
        "title": "Build with Blaster",
        "description": "Enhance your ability to write high assurance smart contract code.",
        "icon": "images/blaster-logo.png",
        "steps": [
          {
            "id": "getStarted",
            "title": "Get Started",
            "description": "View the documentation and minimal examples to get up and running.",
            "completionEvents": [
              "onContext:true"
            ],
            "media": {
              "markdown": "content/walkthrough/step1-get-started.md"
            }
          },
          {
            "id": "defineProperty",
            "title": "Define Your First Property",
            "description": "Define Lean properties and verify them with Blaster.",
            "completionEvents": [
              "onContext:true"
            ],
            "media": {
              "markdown": "content/walkthrough/step2-define-property.md"
            }
          },
          {
            "id": "support",
            "title": "Support and Troubleshooting",
            "description": "Find help, report issues, and browse common solutions.",
            "completionEvents": [
              "onContext:true"
            ],
            "media": {
              "markdown": "content/walkthrough/step3-support.md"
            }
          },
          {
            "id": "contribute",
            "title": "Contribute to the Project",
            "description": "Join the community and help improve blaster-extension.",
            "completionEvents": [
              "onContext:true"
            ],
            "media": {
              "markdown": "content/walkthrough/step4-contribute.md"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "blaster-extension.refreshTestTree",
        "title": "Blaster: Refresh Test Tree",
        "enablement": "!blaster.busy",
        "icon": "$(refresh)"
      },
      {
        "command": "blaster-extension.runAllTests",
        "title": "Blaster: Run All Tests",
        "enablement": "!blaster.busy",
        "icon": "$(run-all)"
      },
      {
        "command": "blaster-extension.stopTests",
        "title": "Blaster: Stop Tests",
        "icon": "$(stop-circle)",
        "enablement": "blaster.activeTestRun && !blaster.stoppingTests"
      },
      {
        "command": "blaster-extension.collapseAllTests",
        "title": "Blaster: Collapse All Tests"
      },
      {
        "command": "blaster-extension.clearAllTests",
        "title": "Blaster: Clear All Results",
        "enablement": "!blaster.busy"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "blaster-extension.refreshTestTree",
          "when": "view == blaster-test-tree && !blaster.activeTestRun",
          "group": "navigation@1"
        },
        {
          "command": "blaster-extension.runAllTests",
          "when": "view == blaster-test-tree && !blaster.activeTestRun",
          "group": "navigation@2"
        },
        {
          "command": "blaster-extension.stopTests",
          "when": "view == blaster-test-tree && blaster.activeTestRun",
          "group": "navigation@2"
        },
        {
          "command": "blaster-extension.collapseAllTests",
          "when": "view == blaster-test-tree",
          "group": "overflow@1"
        },
        {
          "command": "blaster-extension.clearAllTests",
          "when": "view == blaster-test-tree",
          "group": "overflow@1"
        }
      ]
    },
    "configuration": {
      "title": "Blaster Configuration",
      "type": "object",
      "properties": {
        "blaster-extension.trace": {
          "type": "boolean",
          "default": false,
          "description": "Include raw CLI JSON events in the Blaster output."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "blaster-test-tree",
          "title": "Blaster",
          "icon": "images/blaster-icon.svg"
        }
      ]
    },
    "views": {
      "blaster-test-tree": [
        {
          "id": "blaster-test-tree",
          "name": "Blaster",
          "type": "webview",
          "icon": "images/blaster-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p ./",
    "compile:webview": "npm run build -w webview-ui"
  },
  "devDependencies": {
    "@types/async": "^3.2.26",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.118.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "async": "^3.2.6",
    "rxdb": "^17.4.0"
  }
}
