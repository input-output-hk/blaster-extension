{
  "name": "afv-extension",
  "publisher": "cardano-ha",
  "displayName": "Blaster",
  "description": "Perform automated formal verification on Cardano smart contracts written in Aiken, Plinth, and UPLC in Visual Studio Code.",
  "icon": "images/blaster-logo.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "afv.welcome",
        "title": "Build with Blaster",
        "description": "Enhance your ability to write high assurance smart contract code.",
        "icon": "images/blaster-logo.png",
        "steps": [
          {
            "id": "getStarted",
            "title": "Get Started",
            "description": "View the documentation and minimal examples to get up and running.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "content/walkthrough/step1-get-started.md"
            }
          },
          {
            "id": "defineProperty",
            "title": "Define Your First Property",
            "description": "Learn how to annotate your Plinth code with formal properties.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "content/walkthrough/step2-define-property.md"
            }
          },
          {
            "id": "support",
            "title": "Support and Troubleshooting",
            "description": "Find help, report issues, and browse common solutions.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "content/walkthrough/step3-support.md"
            }
          },
          {
            "id": "contribute",
            "title": "Contribute to the Project",
            "description": "Join the community and help improve Blaster.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "content/walkthrough/step4-contribute.md"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "afv-test-tree",
          "title": "Blaster",
          "icon": "images/blaster-icon.svg"
        }
      ]
    },
    "views": {
      "afv-test-tree": [
        {
          "id": "afv-test-tree",
          "name": "Blaster",
          "type": "webview",
          "icon": "images/blaster-icon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm install && tsc -p ./ && cd webview-ui && npm install && npm run build"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "all": "^0.0.0",
    "vscode-jsonrpc": "^8.2.1"
  }
}
