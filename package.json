{
  "name": "afv-extension",
  "publisher": "Cardano High Assurance | IOE",
  "displayName": "afv-extension",
  "description": "UI for the Automatic Formal Verification tool used to formally verify Cardano smart contracts written in Plinth.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:afv-extension.afv.runAll",
    "onCommand:afv-extension.afv.runFile",
    "onCommand:afv-extension.afv.openPropertyResults"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "blaster.welcome",
        "title": "Build with Blaster",
        "description": "Enhance your ability to write high assurance smart contract code.",
        "icon": "walkthrough/images/plutus_logo.svg",
        "steps": [
          {
            "id": "reopenSetup",
            "title": "Reopen Setup guide",
            "description": "This guide can always be re-opened by clicking on the icon in the top right of the editor container in your workspace.",
            "completionEvents": ["onContext:true"],
            "media": {
              "image": "walkthrough/images/step1.png",
              "altText": "VS Code Documentation menu showing the Setup Guide option"
            }
          },
          {
            "id": "getStarted",
            "title": "Get Started",
            "description": "View the documentation and minimal examples to get up and running.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "walkthrough/step1-get-started.md"
            }
          },
          {
            "id": "defineProperty",
            "title": "Define Your First Property",
            "description": "Learn how to annotate your Plinth code with formal properties.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "walkthrough/step2-define-property.md"
            }
          },
          {
            "id": "support",
            "title": "Support and Troubleshooting",
            "description": "Find help, report issues, and browse common solutions.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "walkthrough/step3-support.md"
            }
          },
          {
            "id": "contribute",
            "title": "Contribute to the Project",
            "description": "Join the community and help improve Blaster.",
            "completionEvents": ["onContext:true"],
            "media": {
              "markdown": "walkthrough/step4-contribute.md"
            }
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "property-panel",
        "contents": "No Properties Detected. \nAdd the properties to your file using the [Universal Annotation Language](https://github.com/input-output-hk/sc-fvt) then save your file to display the properties in this property panel."
      },
      {
        "view": "solver-config",
        "contents": "Solver Configurations view not registerd."
      }
    ],
    "views": {
      "test": [
        {
          "id": "solver-config",
          "name": "Solver Configurations",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "testing/item/context": [
        {
          "command": "afv.openPropertyResults",
          "when": "(testResultState == 'passed' && testId =~ /property:.*/) || (testResultState == 'failed' && testId =~ /property:.*/)",
          "group": "navigation"
        },
        {
          "command": "afv.openPropertyResults",
          "when": "(testResultState == 'passed' && testId =~ /property:.*/) || (testResultState == 'failed' && testId =~ /property:.*/)",
          "group": "inline"
        }
      ],
      "testing/item/result": [
        {
          "command": "afv.openPropertyResults",
          "group": "navigation"
        },
        {
          "command": "afv.openPropertyResults",
          "group": "inline"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "afv.openPropertyResults",
          "when": "(testResultState == 'passed') || (testResultState == 'failed')",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "afv.openPropertyResults",
          "when": "testing.hasAnyResults && activeViewlet == 'workbench.view.extension.test'"
        },
        {
          "command": "afv.runAll",
          "when": "testing.hasRunnableTests && activeViewlet == 'workbench.view.extension.test'"
        }
      ]
    },
    "commands": [
      {
        "command": "afv.runAll",
        "title": "Run All Proofs",
        "category": "afv",
        "description": "Rerun a proof for all properties"
      },
      {
        "command": "afv.runFile",
        "title": "Run File",
        "category": "afv",
        "description": "Run a proof for all properties in the current file"
      },
      {
        "command": "afv.openPropertyResults",
        "title": "View Results",
        "category": "afv",
        "description": "Open the property results view",
        "icon": "$(book)"
      },
      {
        "command": "afv.openWelcome",
        "title": "Open Welcome",
        "category": "afv",
        "description": "Open the Build with Blaster setup guide"
      }
    ],
    "keybindings": [
      {
        "command": "afv.runAll",
        "key": "ctrl+alt+r",
        "when": "testing.hasRunnableTests && activeViewlet == 'workbench.view.extension.test'"
      },
      {
        "command": "afv.openPropertyResults",
        "key": "ctrl+alt+v",
        "when": "testing.hasAnyResults && activeViewlet == 'workbench.view.extension.test'"
      }
    ]
  },
  "scripts": {
    "compile": "npm install && tsc -p ./ && cd webview-ui && npm install && npm run build"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "all": "^0.0.0",
    "vscode-jsonrpc": "^8.2.1"
  }
}
