{
  "name": "afv-extension",
  "publisher": "Cardano High Assurance | IOE",
  "displayName": "afv-extension",
  "description": "UI for the Automatic Formal Verification tool used to formally verify Cardano smart contracts written in Plinth.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Debuggers",
    "Testing",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:afv-extension.afv.runAll",
    "onCommand:afv-extension.afv.runFile",
    "onCommand:afv-extension.afv.openPropertyResults"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "property-panel",
        "contents": "No Properties Detected. \nAdd the properties to your file using the [Universal Annotation Language](https://github.com/input-output-hk/sc-fvt) then save your file to display the properties in this property panel."
      },
      {
        "view": "solverConfigurations",
        "contents": "Solver Configurations view not registerd."
      }
    ],
    "views": {
      "test": [
        {
          "id": "solverConfigurations",
          "name": "Solver Configurations",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "testing/item/context": [
        {
          "command": "afv.openPropertyResults",
          "when": "(testResultState == 'passed' && testId =~ /property:.*/) || (testResultState == 'failed' && testId =~ /property:.*/)",
          "group": "navigation"
        },
         {
          "command": "afv.openPropertyResults",
          "when": "(testResultState == 'passed' && testId =~ /property:.*/) || (testResultState == 'failed' && testId =~ /property:.*/)",
          "group": "inline"
        }
      ],
      "testing/item/result": [
        {
          "command": "afv.openPropertyResults",
          "group": "navigation"
        },
        {
          "command": "afv.openPropertyResults",
          "group": "inline"
        }
      ],
      "editor/lineNumber/context": [
         {
          "command": "afv.openPropertyResults",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "afv.openPropertyResults",
          "when": "testing.hasAnyResults && activeViewlet == 'workbench.view.extension.test'"
        },
         {
        "command": "afv.runAll",
        "when": "testing.hasRunnableTests && activeViewlet == 'workbench.view.extension.test'"
        }
      ]
    },
    "commands": [
      {
        "command": "afv.runAll",
        "title": "Run All Proofs",
        "category": "afv",
        "description": "Rerun a proof for all properties"
      },
      {
        "command": "afv.runFile",
        "title": "Run File",
        "category": "afv",
        "description": "Run a proof for all properties in the current file"
      },
      {
        "command": "afv.openPropertyResults",
        "title": "View Results",
        "category": "afv",
        "description": "Open the property results view",
        "icon": "$(book)"
      }
    ],
    "keybindings": [
      {
        "command": "afv.runAll",
        "key": "ctrl+alt+r",
        "when": "testing.hasRunnableTests && activeViewlet == 'workbench.view.extension.test'"
      },
      {
        "command": "afv.openPropertyResults",
        "key": "ctrl+alt+v",
        "when": "testing.hasAnyResults && activeViewlet == 'workbench.view.extension.test'"
      }
    ]
  },
  "scripts": {
    "install:all": "npm install && cd webview-ui && npm install",
    "start:webview": "cd webview-ui && npm run start",
    "build:webview": "cd webview-ui && npm run build",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "all": "^0.0.0",
    "zustand": "^5.0.6"
  }
}
